# Bu dosyayı ".env" adıyla kopyala ve gerçek değerlerle doldur.
# ".env" dosyası ASLA git'e eklenmemeli (zaten .gitignore'da olmalı).

# --- ZORUNLU (bunlar olmadan sunucu başlamaz) ---
# Rastgele, uzun ve tahmin edilemez bir metin olmalı. Üretmek için terminalde:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Docker container'ını kurarken belirlediğin PostgreSQL şifresi
DB_PASSWORD=

# --- VERİTABANI (varsayılanlar genelde doğrudur, Docker kurulumuna göre değişebilir) ---
DB_USER=postgres
DB_HOST=localhost
DB_NAME=postgres
DB_PORT=5432

# --- SUNUCU ---
PORT=5005

# --- iyzico (sandbox test anahtarları kod içinde fallback olarak duruyor,
# canlıya çıkmadan önce buraya GERÇEK anahtarlarını gir) ---
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_URI=https://sandbox-api.iyzipay.com

# --- URL'LER ---
# Geliştirme sırasında bunlar localhost, canlıya çıkınca gerçek domain'lerinle değiştir
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5005
