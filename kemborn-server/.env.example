# Bu dosyayı ".env" adıyla kopyala ve gerçek değerlerle doldur.
# ".env" dosyası ASLA git'e eklenmemeli (.gitignore'da zaten var).
#
# Veritabanını sıfırdan kuruyorsan önce şunları çalıştır:
#   psql ... -f db/schema.sql
#   psql ... -f db/seed.sql


# ============================================================
# ZORUNLU — bunlar olmadan sunucu hiç başlamaz
# ============================================================

# Rastgele, uzun ve tahmin edilemez bir metin. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# PostgreSQL şifresi (Docker container'ını kurarken belirlediğin)
DB_PASSWORD=


# ============================================================
# VERİTABANI — varsayılanlar yerel Docker kurulumu içindir
# ============================================================
DB_USER=postgres
DB_HOST=localhost
DB_NAME=postgres
DB_PORT=5432

# Railway, Render gibi yönetilen PostgreSQL servisleri şifreli bağlantı ister.
# Yerelde "false" bırak, canlıda "true" yap.
DB_SSL=false


# ============================================================
# SUNUCU
# ============================================================
PORT=5005

# Geliştirmede localhost, canlıda gerçek adreslerin
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5005


# ============================================================
# ÖDEME — PayTR
# ============================================================
# Bu üçü olmadan ödeme alma çalışmaz (sunucu başlar ama uyarı verir).
# Değerler PayTR Mağaza Paneli'nden alınır.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# 1 = test modu (gerçek para çekilmez, test kartlarıyla denenir)
# 0 = canlı mod. Canlıya çıkarken 0 yap.
PAYTR_TEST_MODE=1

# ÖNEMLİ: PayTR'nin ödeme sonucunu bildirdiği adres koddan değil, PayTR
# panelinden ayarlanır:  Ayarlar > Bildirim URL
#   https://<backend-adresin>/api/paytr-notify


# ============================================================
# E-POSTA — Gmail SMTP
# ============================================================
# Bunlar tanımlı değilse sipariş, kargo ve şifre sıfırlama e-postaları
# GÖNDERİLMEZ (sunucu çökmez, sadece log'a yazar).
#
# EMAIL_APP_PASSWORD normal Gmail şifren DEĞİL; Google Hesabı'ndan üretilen
# 16 haneli "Uygulama Şifresi"dir (2 Adımlı Doğrulama açık olmalı).
EMAIL_USER=
EMAIL_APP_PASSWORD=
