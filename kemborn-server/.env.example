# Bu dosyayı ".env" adıyla kopyala ve gerçek değerlerle doldur.
# ".env" dosyası ASLA git'e eklenmemeli (.gitignore'da zaten var).
#
# Veritabanını sıfırdan kuruyorsan önce şunları çalıştır:
#   psql ... -f db/schema.sql
#   psql ... -f db/seed.sql


# ============================================================
# ZORUNLU — bunlar olmadan sunucu hiç başlamaz
# ============================================================

# Rastgele, uzun ve tahmin edilemez bir metin. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# PostgreSQL şifresi (Docker container'ını kurarken belirlediğin)
DB_PASSWORD=


# ============================================================
# VERİTABANI — varsayılanlar yerel Docker kurulumu içindir
# ============================================================
DB_USER=postgres
DB_HOST=localhost
DB_NAME=postgres
DB_PORT=5432

# Railway, Render gibi yönetilen PostgreSQL servisleri şifreli bağlantı ister.
# Yerelde "false" bırak, canlıda "true" yap.
DB_SSL=false


# ============================================================
# SUNUCU
# ============================================================
PORT=5005

# Geliştirmede localhost, canlıda gerçek adreslerin
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5005

# API'ye istek atmasına izin verilen EK adresler (virgülle ayır).
# kemborn.com ve www.kemborn.com zaten kodda tanımlı, localhost da serbest.
# Yeni bir Vercel alias'ı ya da test alan adı eklemen gerekirse buraya yaz:
#   EXTRA_ALLOWED_ORIGINS=https://kemborn-yeni.vercel.app,https://test.kemborn.com
EXTRA_ALLOWED_ORIGINS=


# ============================================================
# ÖDEME — PayTR
# ============================================================
# Bu üçü olmadan ödeme alma çalışmaz (sunucu başlar ama uyarı verir).
# Değerler PayTR Mağaza Paneli'nden alınır.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# 1 = test modu (gerçek para çekilmez, test kartlarıyla denenir)
# 0 = canlı mod. Canlıya çıkarken 0 yap.
PAYTR_TEST_MODE=1

# ÖNEMLİ: PayTR'nin ödeme sonucunu bildirdiği adres koddan değil, PayTR
# panelinden ayarlanır:  Ayarlar > Bildirim URL
#   https://<backend-adresin>/api/paytr-notify


# ============================================================
# E-POSTA — Resend (HTTPS API)
# ============================================================
# Bunlar tanımlı değilse sipariş, kargo ve şifre sıfırlama e-postaları
# GÖNDERİLMEZ (sunucu çökmez, sadece log'a yazar).
#
# Gmail SMTP'den Resend'e geçildi: Railway'in çıkışı SMTP portlarını (465/587)
# bloke ediyor, Resend düz HTTPS üzerinden çalıştığı için etkilenmiyor.
# resend.com'dan alınır.
RESEND_API_KEY=

# Gönderen adresi. kemborn.com Resend'de doğrulanana kadar varsayılan
# (Kemborn <onboarding@resend.dev>) kullanılır — bu adres SADECE Resend
# hesabının kendi e-postasına teslim olur, gerçek müşteriye gitmez. Domain
# doğrulanınca buraya örn. "Kemborn <bildirim@kemborn.com>" yazılır.
EMAIL_FROM=

# Yeni sipariş / iletişim formu geldiğinde bildirimin gideceği adres.
ADMIN_NOTIFY_EMAIL=
